# =======================================================
# Meowzic Discord Music Bot - Configuration (.env)
# =======================================================

# Discord Bot Credentials
# Get your token and application ID from: https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Bot Settings
DEFAULT_PREFIX=+
DEFAULT_VOLUME=80

# Primary Lavalink Node (Pre-configured with verified high-performance Lavalink v4 node)
# You can also change this to your own local node (e.g. 127.0.0.1:2333) or private VPS
LAVALINK_HOST=lavalink.nazha.online
LAVALINK_PORT=443
LAVALINK_PASSWORD=nazhafreelava
LAVALINK_SECURE=true
LAVALINK_NAME=Global-Lavalink-v4

# Fallback Lavalink Node
FALLBACK_LAVALINK_HOST=lava-v4.millohost.my.id
FALLBACK_LAVALINK_PORT=443
FALLBACK_LAVALINK_PASSWORD=https://discord.gg/mjS5J2K3ep
FALLBACK_LAVALINK_SECURE=true

# Spotify API Credentials (Optional - Spotify track metadata resolution works out of the box, but add these for higher rate limits)
# Get credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Bot Branding & Customization
EMBED_COLOR=#7C3AED
BOT_ACTIVITY_NAME=Meowzic | /play
BOT_ACTIVITY_TYPE=LISTENING
